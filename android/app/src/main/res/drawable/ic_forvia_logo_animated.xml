<?xml version="1.0" encoding="utf-8"?>
<!--
  Fades ic_forvia_logo_vector.xml's whole mark in as one piece — bars and the "F" together,
  near-simultaneously (a tiny stagger for a touch of life, nothing like the previous version's
  full per-shape stroke-draw, which visibly showed the lime bars alone for the better part of a
  second before the white F ever appeared — that read as a stray green flash on a real device,
  not as one animation). SplashActivity starts this, waits out its own duration, then moves on.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_forvia_logo_vector">

  <target android:name="lime1">
    <aapt:attrib name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="450"
          android:startOffset="0" android:valueFrom="0" android:valueTo="1" />
    </aapt:attrib>
  </target>

  <target android:name="lime2">
    <aapt:attrib name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="450"
          android:startOffset="0" android:valueFrom="0" android:valueTo="1" />
    </aapt:attrib>
  </target>

  <target android:name="lime3">
    <aapt:attrib name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="450"
          android:startOffset="40" android:valueFrom="0" android:valueTo="1" />
    </aapt:attrib>
  </target>

  <target android:name="lime4">
    <aapt:attrib name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="450"
          android:startOffset="40" android:valueFrom="0" android:valueTo="1" />
    </aapt:attrib>
  </target>

  <target android:name="lime5">
    <aapt:attrib name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="450"
          android:startOffset="80" android:valueFrom="0" android:valueTo="1" />
    </aapt:attrib>
  </target>

  <target android:name="ink1">
    <aapt:attrib name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="450"
          android:startOffset="80" android:valueFrom="0" android:valueTo="1" />
    </aapt:attrib>
  </target>

  <target android:name="ink2">
    <aapt:attrib name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:duration="450"
          android:startOffset="80" android:valueFrom="0" android:valueTo="1" />
    </aapt:attrib>
  </target>

</animated-vector>
