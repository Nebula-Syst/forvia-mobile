<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity's loading overlay — added on top of the WebView and kept visible until the page
     actually has something to show. A plain static PNG on purpose, not the animated vector
     SplashActivity uses: that same drawable reliably failed to ever actually animate here (solid
     black, logo never appeared) across several real-device-confirmed attempts to fix the timing,
     for reasons that couldn't be pinned down without a device to debug on directly. A static
     bitmap has no start()/attach-timing/animator-callback path to go wrong — it just draws,
     every time. Losing the "draws itself in" flourish here is the right trade: SplashActivity's
     own animated intro (proven working) still plays before this ever shows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_loading_logo" />

</FrameLayout>
