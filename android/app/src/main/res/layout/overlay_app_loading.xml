<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity's loading overlay — a small dedicated WebView (loading.html, assets/) playing the
     exact same SVG draw-in animation as the main web app's own logo, looped. See MainActivity's
     own comment for why this is a WebView and not a native AnimatedVectorDrawable. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/loading_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
