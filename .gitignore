node_modules/
dist/

# Android — generated icons/splash (mipmap-*, drawable-*) ARE versioned
# (npx capacitor-assets generate can redo them, but committing skips that
# step in CI).
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/.cxx/
*.keystore
*.jks
# The debug keystore IS committed on purpose — see android/app/build.gradle's own comment on why
# a fixed, shared debug key matters here (consecutive sideloaded builds need matching signatures
# to install as updates instead of forcing an uninstall). Nothing secret in it: fixed, well-known
# passwords, debug-only, never used for anything Play Store cares about.
!android/app/debug.keystore
keystore.properties

.DS_Store
