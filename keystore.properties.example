# Copy to "keystore.properties" (gitignored) to sign a release build (./gradlew bundleRelease)
# on your own machine. CI never reads this file — it uses the RELEASE_STORE_FILE/
# RELEASE_STORE_PASSWORD/RELEASE_KEY_ALIAS/RELEASE_KEY_PASSWORD repo secrets instead (see
# .github/workflows/build-apk.yml). Neither present: release builds fall back to the debug key,
# same as before this existed — fine for local testing, not for a Play Store upload.
storeFile=/absolute/path/to/forvia-release.keystore
storePassword=
keyAlias=forvia
keyPassword=
